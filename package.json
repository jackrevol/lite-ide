{
  "name": "lite-ide",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal desktop workspace for Codex",
  "author": "jackrevol",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.cjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "node --experimental-strip-types --test src/main/git.test.ts src/main/settings-service.test.ts src/main/agent-service.test.ts src/main/subagent-service.test.ts src/main/codex-client.test.ts src/main/update-service.test.ts src/main/update-installer.test.ts src/renderer/src/lib/workspace-state.test.ts src/main/terminal-service.test.ts",
    "test:ui": "node scripts/check-ui.mjs",
    "test:codex": "node scripts/check-codex.mjs",
    "build:icons": "electron scripts/build-icons.cjs",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "afterPack": "scripts/prepare-pty.cjs",
    "appId": "dev.jackrevol.liteide",
    "productName": "Lite IDE",
    "artifactName": "Lite-IDE-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/icon.ico",
      "package.json",
      "LICENSE",
      "LICENSE.coss-ui"
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  }
}
